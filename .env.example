# ============ AI 循环衣橱 环境变量模板 ============
# 复制为 .env 并填写真实值

# --- Supabase ---
# Project Settings → API 里获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# 仅服务端使用，切勿暴露给前端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- 服务端口 ---
PORT=3001

# --- AI (AIService) ---
# 驱动：openai-compatible | rule-engine | teleagent-bridge
AI_DRIVER=rule-engine
# OpenAI 兼容 API（天翼云 TokenHub / DeepSeek / OpenAI 等任意兼容端点）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- TeleAgent 桥接（可选） ---
TELEAGENT_BRIDGE_URL=

# --- CORS 白名单（逗号分隔） ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3001